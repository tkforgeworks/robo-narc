[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/debug/debug_menu.gd" id="1_menu"]

[node name="DebugMenu" type="CanvasLayer"]
layer = 100
script = ExtResource("1_menu")

[node name="Root" type="PanelContainer" parent="."]
theme_type_variation = &"DebugPanel"
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 24.0
offset_right = -40.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Root"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Root/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Root/Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Root/Margin/Column/Header"]
theme_type_variation = &"PanelTitle"
layout_mode = 2
size_flags_horizontal = 3
text = "DEBUG / TUNING (game paused)"
text_overrun_behavior = 3

[node name="CloseButton" type="Button" parent="Root/Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Close (F1)"

[node name="Actions" type="HFlowContainer" parent="Root/Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6

[node name="ResetButton" type="Button" parent="Root/Margin/Column/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Reset to defaults"

[node name="SaveButton" type="Button" parent="Root/Margin/Column/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Save overrides"

[node name="Scroll" type="ScrollContainer" parent="Root/Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Sections" type="VBoxContainer" parent="Root/Margin/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8
