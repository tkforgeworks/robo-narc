[node name="InitialLabel" type="Label" parent="Fields"]
theme_type_variation = &"BodyText"
layout_mode = 2
text = "Last initial"
horizontal_alignment = 2

[node name="InitialEdit" type="LineEdit" parent="Fields"]
theme_type_variation = &"NameEdit"
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
size_flags_horizontal = 0
placeholder_text = "K"
alignment = 1
