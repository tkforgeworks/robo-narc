[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/game/ui/identity_entry.gd" id="1_entry"]

[node name="IdentityEntry" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_entry")

[node name="Prompt" type="Label" parent="."]
theme_type_variation = &"SectionHeading"
layout_mode = 2
text = "YOUR NAME FOR THE BOARD"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="."]
theme_type_variation = &"Caption"
layout_mode = 2
text = "Leave it all blank to play as anonymous"
horizontal_alignment = 1

[node name="Fields" type="GridContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 8
columns = 2

[node name="EmailLabel" type="Label" parent="Fields"]
theme_type_variation = &"BodyText"
layout_mode = 2
text = "Email"
horizontal_alignment = 2

[node name="EmailEdit" type="LineEdit" parent="Fields"]
theme_type_variation = &"NameEdit"
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
placeholder_text = "you@example.com"
max_length = 254

[node name="FirstNameLabel" type="Label" parent="Fields"]
theme_type_variation = &"BodyText"
layout_mode = 2
text = "First name"
horizontal_alignment = 2

[node name="FirstNameEdit" type="LineEdit" parent="Fields"]
theme_type_variation = &"NameEdit"
unique_name_in_owner = true
